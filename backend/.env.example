# ============================================================
# Multi-Tenant Text-to-SQL and Document Chat Platform
# Environment Variables — COPY THIS FILE TO .env AND FILL IN
# ============================================================

# ─────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────
APP_NAME="Text-to-SQL Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=false
SECRET_KEY="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"
ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY="CHANGE_ME_JWT_SECRET_64_CHARS_MINIMUM_PLEASE"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────────────────────────
# ENCRYPTION (for database credentials stored in DB)
# ─────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="CHANGE_ME_FERNET_KEY_BASE64_URL_SAFE_44_CHARS=="

# ─────────────────────────────────────────────────────────────
# APPLICATION DATABASE (PostgreSQL + pgvector)
# ─────────────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=texttosql_db
DATABASE_USER=texttosql_user
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Async DSN (used by SQLAlchemy)
# DATABASE_URL is built automatically from above, or override:
# DATABASE_URL=postgresql+asyncpg://texttosql_user:password@localhost:5432/texttosql_db

# ─────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_CACHE_TTL_SECONDS=3600      # Default cache TTL (1 hour)
REDIS_SCHEMA_CACHE_TTL=86400      # Schema metadata cache (24 hours)

# ─────────────────────────────────────────────────────────────
# MINIO (Object Storage)
# ─────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

# ─────────────────────────────────────────────────────────────
# CELERY
# ─────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false     # Set true in tests
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY=60

# ─────────────────────────────────────────────────────────────
# OPENAI
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT_SECONDS=60

# ─────────────────────────────────────────────────────────────
# TEXT-TO-SQL SETTINGS
# ─────────────────────────────────────────────────────────────
SQL_QUERY_TIMEOUT_SECONDS=30
SQL_MAX_RESULT_ROWS=1000
SQL_MAX_SCHEMA_TABLES_IN_CONTEXT=50
SQL_MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────
# RAG SETTINGS
# ─────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
RAG_TOP_K=10
RAG_RERANKER_ENABLED=false
RAG_RERANKER_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_FILE_SIZE_MB=100

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_CHAT_REQUESTS_PER_MINUTE=20

# ─────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=text-to-sql-platform
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                    # json | console

# ─────────────────────────────────────────────────────────────
# SUPERADMIN (created on first boot)
# ─────────────────────────────────────────────────────────────
SUPERADMIN_EMAIL=admin@platform.local
SUPERADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SUPERADMIN_TENANT_NAME="Platform Admin"
SUPERADMIN_TENANT_SLUG=platform-admin
